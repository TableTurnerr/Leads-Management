# Auth (cloud Supabase project — used only for sign in/up/refresh)
NEXT_PUBLIC_SUPABASE_AUTH_URL=https://your-cloud-ref.supabase.co
NEXT_PUBLIC_SUPABASE_AUTH_ANON_KEY=your-cloud-anon-key

# Data (self-hosted Supabase — verifies cloud JWTs via JWKS)
NEXT_PUBLIC_SUPABASE_DATA_URL=https://supabase.tableturnerr.com
NEXT_PUBLIC_SUPABASE_DATA_ANON_KEY=your-local-anon-key
SUPABASE_DATA_SERVICE_ROLE_KEY=your-local-service-role-key

# For Testing Only:
LOGIN_USERNAME=your-login-username-here
LOGIN_PASSWORD=your-login-password-here
